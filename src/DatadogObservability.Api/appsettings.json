{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Datadog": {
    "Service": "datadog-observability-demo",
    "Env": "development",
    "Version": "1.0.0"
  },
  "ExternalApi": {
    "BaseUrl": "https://example.com",
    "TimeoutSeconds": 10
  },
  "Monitoring": {
    "SlowDefaultMs": 3000,
    "MaxSlowDelayMs": 30000
  },
  "Swagger": { "Enabled": true }
}
