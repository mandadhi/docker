<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Version surfaced by /api/health; DD_VERSION overrides at runtime. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Manual instrumentation API only (custom spans/tags). It does NOT enable the profiler.
         Automatic instrumentation comes from the Datadog App Service extension (Windows)
         or the sidecar + Datadog.Trace.Bundle (Linux). Never ship both Datadog.Trace and
         Datadog.Trace.Bundle. -->
    <PackageReference Include="Datadog.Trace" Version="3.57.0" />
    <!-- DogStatsD client for custom metrics (the AAS extension bundles a DogStatsD listener). -->
    <PackageReference Include="DogStatsD-CSharp-Client" Version="9.2.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Optional agentless log shipping (enabled only when DD_LOGS_DIRECT_ENABLED=true). -->
    <PackageReference Include="Serilog.Sinks.Datadog.Logs" Version="0.6.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

</Project>
